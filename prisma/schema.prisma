// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  name      String
  username  String       @unique
  password  String
  roles     UserRole[]
  regions   UserRegion[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  label       String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
  @@index([userId])
  @@index([roleId])
}

model Region {
  id           String        @id @default(uuid())
  name         String
  coverage     String[]
  users        UserRegion[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
}

model UserRegion {
  userId   String
  regionId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([regionId, userId])
  @@index([userId])
  @@index([regionId])
}

model Province {
  id   Int    @id @default(autoincrement())
  name String
  code String

  regencies    Regency[]
  participants Participant[]
}

model Regency {
  id        Int        @id @default(autoincrement())
  name      String
  label     String?
  type      String?
  code      String
  fullCode  String
  districts District[]

  provinceId   Int
  province     Province      @relation(fields: [provinceId], references: [id])
  participants Participant[]

  @@index([provinceId])
}

model District {
  id       Int       @id @default(autoincrement())
  name     String
  code     String
  fullCode String
  villages Village[]

  regencyId    Int
  regency      Regency       @relation(fields: [regencyId], references: [id])
  participants Participant[]

  @@index([regencyId])
}

model Village {
  id         Int    @id @default(autoincrement())
  name       String
  code       String
  fullCode   String
  postalCode String

  districtId   Int
  district     District      @relation(fields: [districtId], references: [id])
  participants Participant[]

  @@index([districtId])
}

model Participant {
  id             String   @id @default(uuid())
  noRegistration String   @map("no_registration")
  fullName       String   @map("full_name")
  password       String?
  nik            String   @unique
  birthPlace     String   @map("birth_place")
  birthDate      DateTime @map("birt_date")
  gender         Gender
  fatherName     String   @map("father_name")
  motherName     String   @map("mother_name")
  parentPhone    String   @map("parrent_phone")
  provinceId     Int
  province       Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  regencyId      Int
  regency        Regency  @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  districtId     Int
  district       District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  villageId      Int
  village        Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  postalCode     String?
  address        String?
  kkUrl          String
  ijazahUrl      String
  photoUrl       String

  institutionName    String @map("institution_name")
  institutionAddress String @map("institution_address")
  regionId           String
  region             Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  subcategoryId Int
  subcategory   CategoryToSubcategory @relation(fields: [subcategoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

enum Gender {
  PUTRA
  PUTRI
}

model Category {
  id               Int                     @id @default(autoincrement())
  name             String                  @unique
  subcategories    CategoryToSubcategory[] @relation("CategoryToSub")
  parentCategories CategoryToSubcategory[] @relation("SubcategoryToCategory")
}

model CategoryToSubcategory {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  subcategoryId Int
  category      Category @relation("CategoryToSub", fields: [categoryId], references: [id])
  subcategory   Category @relation("SubcategoryToCategory", fields: [subcategoryId], references: [id])

  participants Participant[]

  @@unique([categoryId, subcategoryId])
}
